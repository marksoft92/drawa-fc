generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(PLAYER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  player   Player?
  sessions Session[]
}

enum Role {
  ADMIN
  PLAYER
  STAFF
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Piłkarze ─────────────────────────────────────────────────────────────────

model Player {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imieNazwisko  String
  pozycja       String?
  numer         Int?
  dataUrodzenia DateTime?
  foto          String?
  pseudonim     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stats         SezonStats[]
}

// ─── Sezony i statystyki ──────────────────────────────────────────────────────

model Sezon {
  id        String   @id @default(cuid())
  nazwa     String   @unique
  aktywny   Boolean  @default(false)
  createdAt DateTime @default(now())

  stats     SezonStats[]
}

model SezonStats {
  id           String   @id @default(cuid())
  playerId     String
  sezonId      String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sezon        Sezon    @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  mecze        Int      @default(0)
  gole         Int      @default(0)
  asysty       Int      @default(0)
  zolte        Int      @default(0)
  czerwone     Int      @default(0)
  meczePuchar  Int      @default(0)
  golePuchar   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([playerId, sezonId])
}

// ─── Aktualności ─────────────────────────────────────────────────────────────

model Artykul {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  thumbnail String?
  kolor     String?
  tags      String[]
  photos    Json     @default("[]")
  published Boolean  @default(true)
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Liga (tabela + mecze) ────────────────────────────────────────────────────

model TabelaDruzyna {
  id        String   @id @default(cuid())
  sezon     String
  pozycja   Int
  nazwa     String
  herb      String?
  pkt       Int      @default(0)
  mecze     Int      @default(0)
  wygrane   Int      @default(0)
  remisy    Int      @default(0)
  przegrane Int      @default(0)
  bramkiZd  Int      @default(0)
  bramkiStr Int      @default(0)
  forma     String?
  updatedAt DateTime @updatedAt

  @@unique([sezon, pozycja])
}

model Mecz {
  id        String   @id @default(cuid())
  sezon     String
  liga      String?
  team1     String
  team2     String
  herb1     String?
  herb2     String?
  score     String?
  date      String?
  walkower  Boolean  @default(false)
  status    String?
  komentarz String?
  strzelcy  Json     @default("[]")
  kartki    Json     @default("[]")
  zmiany    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sezon, team1, team2, date])
}

// ─── Galeria ──────────────────────────────────────────────────────────────────

model Album {
  id         String   @id @default(cuid())
  slug       String   @unique
  tytul      String
  date       String
  tags       String[]
  thumbnail  String?
  author     String?
  hrefAuthor String?
  photos     Json     @default("[]")
  kolejnosc  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Ustawienia (klucz-wartość) ───────────────────────────────────────────────

model Ustawienie {
  klucz     String   @id
  wartosc   String   @default("")
  updatedAt DateTime @updatedAt
}

// ─── Struktura klubu ──────────────────────────────────────────────────────────

model ZarzadOsoba {
  id        String   @id @default(cuid())
  rola      String
  imie      String
  telefon   String?
  email     String?
  kolejnosc Int      @default(0)
  aktywny   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Sponsorzy ────────────────────────────────────────────────────────────────

model Sponsor {
  id         String   @id @default(cuid())
  nazwa      String
  logo       String?
  href       String?
  kolejnosc  Int      @default(0)
  aktywny    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

