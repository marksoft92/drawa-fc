generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(PLAYER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  player   Player?
  sessions Session[]
}

enum Role {
  ADMIN
  PLAYER
  STAFF
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Piłkarze ─────────────────────────────────────────────────────────────────

model Player {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imieNazwisko  String
  pozycja       String?
  numer         Int?
  dataUrodzenia DateTime?
  foto          String?
  pseudonim     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stats         SezonStats[]
}

// ─── Sezony i statystyki ──────────────────────────────────────────────────────

model Sezon {
  id        String   @id @default(cuid())
  nazwa     String   @unique
  aktywny   Boolean  @default(false)
  createdAt DateTime @default(now())

  stats     SezonStats[]
}

model SezonStats {
  id           String   @id @default(cuid())
  playerId     String
  sezonId      String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sezon        Sezon    @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  mecze        Int      @default(0)
  gole         Int      @default(0)
  asysty       Int      @default(0)
  zolte        Int      @default(0)
  czerwone     Int      @default(0)
  meczePuchar  Int      @default(0)
  golePuchar   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([playerId, sezonId])
}

// ─── Aktualności ─────────────────────────────────────────────────────────────

model Artykul {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  thumbnail String?
  kolor     String?
  tags      String[]
  photos    Json     @default("[]")
  published Boolean  @default(true)
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

