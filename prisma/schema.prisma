generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(PLAYER)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  lastSeen           DateTime?
  showOnline         Boolean  @default(true)
  notifChat          Boolean  @default(true)
  notifDm            Boolean  @default(true)
  notifAnkiety       Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  player            Player?
  sessions          Session[]
  ankietyUtworzono  Ankieta[]         @relation("AnkietaCreator")
  ankietyGlosy      AnkietaGlos[]     @relation("AnkietaGlosy")
  pushSubscriptions PushSubscription[]
  chatWiadomosci    ChatWiadomosc[]   @relation("ChatAuthor")
  chatReakcje       ChatReakcja[]     @relation("ChatReakcje")
  chatOdczytanie    ChatOdczytanie?
  dmConvUser1       PrivateConversation[] @relation("DmUser1")
  dmConvUser2       PrivateConversation[] @relation("DmUser2")
  dmWiadomosci      PrivateWiadomosc[]    @relation("DmAuthor")
  dmReakcje         PrivateReakcja[]      @relation("DmReakcje")
  dmOdczytania      PrivateOdczytanie[]   @relation("DmOdczytanie")
}

enum Role {
  ADMIN
  PLAYER
  STAFF
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Piłkarze ─────────────────────────────────────────────────────────────────

model Player {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imieNazwisko  String
  pozycja       String?
  numer         Int?
  dataUrodzenia DateTime?
  foto          String?
  pseudonim     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stats         SezonStats[]
  kadra         KadraSezon[]
}

// ─── Sezony i statystyki ──────────────────────────────────────────────────────

model Sezon {
  id        String   @id @default(cuid())
  nazwa     String   @unique
  aktywny   Boolean  @default(false)
  createdAt DateTime @default(now())

  stats     SezonStats[]
  kadra     KadraSezon[]
}

model KadraSezon {
  id        String   @id @default(cuid())
  playerId  String
  sezonId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sezon     Sezon    @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([playerId, sezonId])
}

model SezonStats {
  id           String   @id @default(cuid())
  playerId     String
  sezonId      String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sezon        Sezon    @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  mecze        Int      @default(0)
  gole         Int      @default(0)
  asysty       Int      @default(0)
  zolte        Int      @default(0)
  czerwone     Int      @default(0)
  meczePuchar  Int      @default(0)
  golePuchar   Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([playerId, sezonId])
}

// ─── Aktualności ─────────────────────────────────────────────────────────────

model Artykul {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  thumbnail String?
  kolor     String?
  tags      String[]
  photos    Json     @default("[]")
  published Boolean  @default(true)
  pinned    Boolean  @default(false)
  podobne   String[] @default([])
  date      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Liga (tabela + mecze) ────────────────────────────────────────────────────

model TabelaDruzyna {
  id        String   @id @default(cuid())
  sezon     String
  pozycja   Int
  nazwa     String
  herb      String?
  pkt       Int      @default(0)
  mecze     Int      @default(0)
  wygrane   Int      @default(0)
  remisy    Int      @default(0)
  przegrane Int      @default(0)
  bramkiZd  Int      @default(0)
  bramkiStr Int      @default(0)
  forma     String?
  updatedAt DateTime @updatedAt

  @@unique([sezon, pozycja])
}

model Mecz {
  id        String   @id @default(cuid())
  sezon     String
  liga      String?
  team1     String
  team2     String
  herb1     String?
  herb2     String?
  score     String?
  date      String?
  walkower  Boolean  @default(false)
  status    String?
  komentarz String?
  strzelcy           Json     @default("[]")
  kartki             Json     @default("[]")
  zmiany             Json     @default("[]")
  wszystkieZdarzenia Json     @default("[]")
  sklady             Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sezon, team1, team2, date])
}

// ─── Archiwum historyczne ─────────────────────────────────────────────────────

model ArchiwumSezon {
  id        String   @id @default(cuid())
  sourceId  Int      @unique
  sezon     String?
  liga      String
  sourceUrl String?
  createdAt DateTime @default(now())

  mecze     ArchiwumMecz[]
  tabela    ArchiwumTabela[]
}

model ArchiwumMecz {
  id          String         @id @default(cuid())
  sezonId     String
  sezon       ArchiwumSezon  @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  kolejka     Int?
  date        String?
  team1       String
  team2       String
  score       String?
  strzelcy    Json           @default("[]")
  kartki      Json           @default("[]")
  zdarzenia   Json           @default("[]")
  komentarz   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ArchiwumTabela {
  id        String         @id @default(cuid())
  sezonId   String
  sezon     ArchiwumSezon  @relation(fields: [sezonId], references: [id], onDelete: Cascade)
  pozycja   Int
  nazwa     String
  mecze     Int            @default(0)
  pkt       Int            @default(0)
  wygrane   Int            @default(0)
  remisy    Int            @default(0)
  przegrane Int            @default(0)
  bramki    String?

  @@index([sezonId])
}

// ─── Galeria ──────────────────────────────────────────────────────────────────

model Album {
  id         String   @id @default(cuid())
  slug       String   @unique
  tytul      String
  date       String
  tags       String[]
  thumbnail  String?
  author     String?
  hrefAuthor String?
  photos     Json     @default("[]")
  kolejnosc  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Strony statyczne ─────────────────────────────────────────────────────────

model Strona {
  id          String   @id @default(cuid())
  slug        String   @unique
  tytul       String
  tresc       String
  metaOpis    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Wideo (YouTube) ──────────────────────────────────────────────────────────

model Wideo {
  id        String   @id @default(cuid())
  url       String
  tytul     String
  opis      String   @default("")
  typ       String   @default("video")
  kolejnosc Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Ustawienia (klucz-wartość) ───────────────────────────────────────────────

model Ustawienie {
  klucz     String   @id
  wartosc   String   @default("")
  updatedAt DateTime @updatedAt
}

// ─── Struktura klubu ──────────────────────────────────────────────────────────

model ZarzadOsoba {
  id        String   @id @default(cuid())
  rola      String
  imie      String
  telefon   String?
  email     String?
  kolejnosc Int      @default(0)
  aktywny   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Sponsorzy ────────────────────────────────────────────────────────────────

model Sponsor {
  id         String   @id @default(cuid())
  nazwa      String
  slug       String?  @unique
  logo       String?
  href       String?
  facebook   String?
  instagram  String?
  opis       String?
  opisDlugi  String?
  kolejnosc  Int      @default(0)
  aktywny    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatWiadomosc {
  id          String   @id @default(cuid())
  tresc       String?
  typ         String   @default("text")
  plik        String?
  authorId    String
  author      User     @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  usunieta    Boolean  @default(false)
  createdAt   DateTime @default(now())
  editedAt    DateTime?
  replyToId   String?
  replyTo     ChatWiadomosc?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ChatWiadomosc[] @relation("ChatReply")

  reakcje     ChatReakcja[]
}

model ChatReakcja {
  id      String        @id @default(cuid())
  wiadId  String
  wiad    ChatWiadomosc @relation(fields: [wiadId], references: [id], onDelete: Cascade)
  userId  String
  user    User          @relation("ChatReakcje", fields: [userId], references: [id], onDelete: Cascade)
  emoji   String

  @@unique([wiadId, userId, emoji])
}

model ChatOdczytanie {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ostatniaId String?
  updatedAt  DateTime @updatedAt
}

// ─── Ankiety ──────────────────────────────────────────────────────────────────

model Ankieta {
  id        String    @id @default(cuid())
  tytul     String
  pytanie   String
  deadline  DateTime?
  aktywna   Boolean   @default(true)
  createdBy String
  creator   User      @relation("AnkietaCreator", fields: [createdBy], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  opcje     AnkietaOpcja[]
  glosy     AnkietaGlos[]
}

model AnkietaOpcja {
  id        String   @id @default(cuid())
  ankietaId String
  ankieta   Ankieta  @relation(fields: [ankietaId], references: [id], onDelete: Cascade)
  tresc     String
  kolejnosc Int      @default(0)

  glosy     AnkietaGlos[]
}

model AnkietaGlos {
  id        String   @id @default(cuid())
  ankietaId String
  ankieta   Ankieta      @relation(fields: [ankietaId], references: [id], onDelete: Cascade)
  opcjaId   String
  opcja     AnkietaOpcja @relation(fields: [opcjaId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("AnkietaGlosy", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([ankietaId, userId])
}

// ─── Push powiadomienia ───────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ─── Typowanie wyników ───────────────────────────────────────────────────

model Typowanie {
  id              String   @id @default(cuid())
  team1           String
  team2           String
  herb1           String?
  herb2           String?
  dataRozpoczecia DateTime
  wynikTeam1      Int?
  wynikTeam2      Int?
  aktywne         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wpisy           TypowanieWpis[]
}

model TypowanieWpis {
  id          String    @id @default(cuid())
  typowanieId String
  typowanie   Typowanie @relation(fields: [typowanieId], references: [id], onDelete: Cascade)
  imie        String
  nazwisko    String
  golTeam1    Int
  golTeam2    Int
  punkty      Int?
  createdAt   DateTime  @default(now())

  @@unique([typowanieId, imie, nazwisko])
}

// ─── Prywatne wiadomości (1-do-1) ────────────────────────────────────────────

model PrivateConversation {
  id         String   @id @default(cuid())
  user1Id    String
  user2Id    String
  user1      User     @relation("DmUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2      User     @relation("DmUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  wiadomosci PrivateWiadomosc[]
  odczytania PrivateOdczytanie[]

  @@unique([user1Id, user2Id])
}

model PrivateWiadomosc {
  id        String              @id @default(cuid())
  convId    String
  conv      PrivateConversation @relation(fields: [convId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation("DmAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  tresc     String?
  typ       String              @default("text")
  plik      String?
  usunieta  Boolean             @default(false)
  replyToId String?
  replyTo   PrivateWiadomosc?  @relation("DmReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   PrivateWiadomosc[] @relation("DmReply")
  reakcje   PrivateReakcja[]
  createdAt DateTime            @default(now())
  editedAt  DateTime?
}

model PrivateReakcja {
  id     String           @id @default(cuid())
  wiadId String
  wiad   PrivateWiadomosc @relation(fields: [wiadId], references: [id], onDelete: Cascade)
  userId String
  user   User             @relation("DmReakcje", fields: [userId], references: [id], onDelete: Cascade)
  emoji  String

  @@unique([wiadId, userId, emoji])
}

// ─── Komentarze publiczne ────────────────────────────────────────────────

model Komentarz {
  id           String   @id @default(cuid())
  typ          String   // "artykul" | "mecz"
  targetId     String
  nick         String
  tresc        String
  emoji        String?
  zatwierdzony Boolean  @default(false)
  odpowiedz    String?
  createdAt    DateTime @default(now())

  reakcje      KomentarzReakcja[]

  @@index([typ, targetId])
  @@index([zatwierdzony])
}

model KomentarzReakcja {
  id            String    @id @default(cuid())
  komentarzId   String
  komentarz     Komentarz @relation(fields: [komentarzId], references: [id], onDelete: Cascade)
  emoji         String
  fingerprintId String
  createdAt     DateTime  @default(now())

  @@unique([komentarzId, fingerprintId, emoji])
  @@index([komentarzId])
}

// ─── Newsletter ──────────────────────────────────────────────────────────────

model NewsletterSub {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique @default(cuid())
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PrivateOdczytanie {
  convId     String
  userId     String
  conv       PrivateConversation @relation(fields: [convId], references: [id], onDelete: Cascade)
  user       User                @relation("DmOdczytanie", fields: [userId], references: [id], onDelete: Cascade)
  ostatniaId String?
  updatedAt  DateTime            @updatedAt

  @@id([convId, userId])
}
